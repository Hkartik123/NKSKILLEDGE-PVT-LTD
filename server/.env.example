# Set this in server/.env using the real NKSKILLEDGE PostgreSQL connection string.
DATABASE_URL="YOUR_REAL_NKSKILLEDGE_POSTGRES_DATABASE_URL"
DATABASE_URL_UNPOOLED="YOUR_REAL_NKSKILLEDGE_UNPOOLED_POSTGRES_CONNECTION_STRING"

# Set a unique, high-entropy signing secret in the server/deployment environment.
JWT_SECRET=

# Optional: Meta WhatsApp Cloud API. Recipient is configured as India +91 7498784109.
# Use a Meta-approved template containing the supplied message and its 10 body parameters.
# Obtain the token, phone number ID, and approved template details from Meta Business Manager.
# Configure credentials in the server/deployment environment only.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_GRAPH_API_VERSION=

# Optional public UPI details for the seat-reservation payment prompt.
# Payment remains pending until an admin verifies the transaction in bank/provider records.
RESERVATION_UPI_ID=
RESERVATION_PAYEE_NAME=NKSKILLEDGE Private Limited

# Optional WhatsApp welcome template sent only after an admin verifies payment.
# Create an approved utility template with these four body variables in order:
# student name, paid amount, program name, reservation ID.
RESERVATION_WHATSAPP_TEMPLATE_NAME=
RESERVATION_WHATSAPP_TEMPLATE_LANGUAGE=en
